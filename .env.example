# Zammad + Traefik + Let's Encrypt — Environment Variables
# Copy this file to `.env` and fill in each value before `docker compose up`.
# `.env` is gitignored — never commit real credential values.
#
# Image versions are NOT set here. The tested tag + sha256 digest for every
# image lives in the compose file's `x-images` block, so `git pull` delivers
# the version combination this repository has tested. To pin a different
# version yourself, uncomment and set the matching *_IMAGE_TAG variable, e.g.:
# ZAMMAD_IMAGE_TAG=ghcr.io/zammad/zammad:7.1.3@sha256:…

# ──────────────────────────────────────────────────────────────────────────────
# Traefik reverse proxy
# ──────────────────────────────────────────────────────────────────────────────

# Email address for Let's Encrypt renewal notices. REQUIRED.
TRAEFIK_ACME_EMAIL=admin@example.com

# Hostname for the Traefik dashboard (basic-auth protected). REQUIRED.
TRAEFIK_HOSTNAME=traefik.zammad.example.com

# Basic Authentication for the Traefik dashboard.
# Format: USERNAME:BCRYPT_HASH (with $ characters doubled to $$ for compose)
#     htpasswd -nbB traefikadmin YOUR_STRONG_PASSWORD | sed 's/\$/\$\$/g'
# REQUIRED — do not ship production without changing this.
TRAEFIK_BASIC_AUTH=change_me_generate_with_htpasswd_and_replace_this_string

# Log level: DEBUG, INFO, WARN, ERROR. Default: WARN.
# TRAEFIK_LOG_LEVEL=WARN

# ──────────────────────────────────────────────────────────────────────────────
# Zammad
# ──────────────────────────────────────────────────────────────────────────────

# Public hostnames — the app and its websocket endpoint each need a DNS
# record pointing at this server. REQUIRED.
ZAMMAD_HOSTNAME=zammad.example.com
ZAMMAD_WEBSOCKET_HOSTNAME=websocket.zammad.example.com

# REQUIRED — generate with:
#     openssl rand -base64 24 | tr -d '/+=' | head -c 32
ZAMMAD_DB_PASSWORD=change_me_before_first_start

# The admin account is created in the Zammad setup wizard on first visit.

# Defaults below are set in the compose file; override only to diverge.
# ZAMMAD_DB_NAME=zammaddb
# ZAMMAD_DB_USER=zammaddbuser
# ZAMMAD_DB_PORT=5432
# ZAMMAD_POSTGRES_HOST=postgres
# ZAMMAD_REDIS_URL=redis://redis:6379
# ZAMMAD_MEMCACHE_SERVERS=memcached:11211
# ZAMMAD_TIMEZONE=America/New_York
# ZAMMAD_ELASTICSEARCH_ENABLED=true
# ZAMMAD_ELASTICSEARCH_HOST=elasticsearch
# ZAMMAD_ELASTICSEARCH_PORT=9200
# ZAMMAD_ELASTICSEARCH_SSL_VERIFY=true

# ──────────────────────────────────────────────────────────────────────────────
# Backups (daily, defaults shown; override only to tune)
# ──────────────────────────────────────────────────────────────────────────────

# BACKUP_TIME=03:00
# HOLD_DAYS=10

# Resource limits (defaults shown). Each service carries memory/CPU limits and
# reservations as compose-level defaults; override any of them here and the
# override survives every git pull. Sizing is per host: raise a limit if a
# service is OOM-killed (docker inspect shows OOMKilled=true).
# ZAMMAD_POSTGRES_MEMORY_LIMIT=1g
# ZAMMAD_POSTGRES_CPU_LIMIT=1.0
# ZAMMAD_POSTGRES_MEMORY_RESERVATION=128m
# ZAMMAD_POSTGRES_CPU_RESERVATION=0.25
# ZAMMAD_REDIS_MEMORY_LIMIT=256m
# ZAMMAD_REDIS_CPU_LIMIT=0.5
# ZAMMAD_REDIS_MEMORY_RESERVATION=32m
# ZAMMAD_REDIS_CPU_RESERVATION=0.1
# ZAMMAD_ELASTICSEARCH_MEMORY_LIMIT=2g
# ZAMMAD_ELASTICSEARCH_CPU_LIMIT=2.0
# ZAMMAD_ELASTICSEARCH_MEMORY_RESERVATION=256m
# ZAMMAD_ELASTICSEARCH_CPU_RESERVATION=0.5
# ZAMMAD_MEMCACHED_MEMORY_LIMIT=256m
# ZAMMAD_MEMCACHED_CPU_LIMIT=0.5
# ZAMMAD_MEMCACHED_MEMORY_RESERVATION=32m
# ZAMMAD_MEMCACHED_CPU_RESERVATION=0.1
# ZAMMAD_INIT_MEMORY_LIMIT=1g
# ZAMMAD_INIT_CPU_LIMIT=1.0
# ZAMMAD_INIT_MEMORY_RESERVATION=128m
# ZAMMAD_INIT_CPU_RESERVATION=0.25
# ZAMMAD_MEMORY_LIMIT=2g
# ZAMMAD_CPU_LIMIT=2.0
# ZAMMAD_MEMORY_RESERVATION=256m
# ZAMMAD_CPU_RESERVATION=0.5
# ZAMMAD_RAILSSERVER_MEMORY_LIMIT=1g
# ZAMMAD_RAILSSERVER_CPU_LIMIT=1.0
# ZAMMAD_RAILSSERVER_MEMORY_RESERVATION=128m
# ZAMMAD_RAILSSERVER_CPU_RESERVATION=0.25
# ZAMMAD_SCHEDULER_MEMORY_LIMIT=1g
# ZAMMAD_SCHEDULER_CPU_LIMIT=1.0
# ZAMMAD_SCHEDULER_MEMORY_RESERVATION=128m
# ZAMMAD_SCHEDULER_CPU_RESERVATION=0.25
# ZAMMAD_WEBSOCKET_MEMORY_LIMIT=1g
# ZAMMAD_WEBSOCKET_CPU_LIMIT=1.0
# ZAMMAD_WEBSOCKET_MEMORY_RESERVATION=128m
# ZAMMAD_WEBSOCKET_CPU_RESERVATION=0.25
# TRAEFIK_MEMORY_LIMIT=256m
# TRAEFIK_CPU_LIMIT=0.5
# TRAEFIK_MEMORY_RESERVATION=64m
# TRAEFIK_CPU_RESERVATION=0.1
# ZAMMAD_BACKUP_MEMORY_LIMIT=256m
# ZAMMAD_BACKUP_CPU_LIMIT=0.5
# ZAMMAD_BACKUP_MEMORY_RESERVATION=32m
# ZAMMAD_BACKUP_CPU_RESERVATION=0.1
